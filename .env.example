# OpenAPI 配置模板：复制为 .env 后按需修改（.env 不提交到仓库）。
# 已存在的系统环境变量优先于 .env 中的同名配置；注释掉的项使用括号中的默认值。

# ==================== 服务 ====================
# 监听端口（默认 3000）
PORT=3000
# 版本号，显示在启动日志中
# VERSION=
# 会话密钥：不设置时每次启动随机生成，重启后登录态失效；多实例部署必须配置同一个值
SESSION_SECRET=
# 外部前端地址：设置后未匹配的页面请求重定向到该地址
# FRONTEND_BASE_URL=

# ==================== 调试 ====================
# 调试模式：输出全部 SQL 与更详细的日志（默认 false）
DEBUG=false
# gin 运行模式：debug 输出路由表与请求详情，其他值为 release（默认 release）
# GIN_MODE=release
# 日志目录：为空只输出到控制台
# LOG_DIR=./logs
# pprof 性能分析（默认 false），开启后监听 PPROF_PORT（默认 8005）
ENABLE_PPROF=false
# PPROF_PORT=8005
# Pyroscope 持续性能分析：设置 PYROSCOPE_URL 后启用
# PYROSCOPE_URL=
# PYROSCOPE_APP_NAME=openapi
# PYROSCOPE_BASIC_AUTH_USER=
# PYROSCOPE_BASIC_AUTH_PASSWORD=
# PYROSCOPE_MUTEX_RATE=5
# PYROSCOPE_BLOCK_RATE=5

# ==================== 数据库 ====================
# SQL_DSN 决定数据库类型：
#   为空或 local                              -> SQLite，文件路径取 SQLITE_PATH
#   postgres://user:pass@host:5432/openapi    -> PostgreSQL
#   user:pass@tcp(host:3306)/openapi          -> MySQL（自动追加 parseTime=true）
SQL_DSN=
# SQLite 文件路径，可带参数；未带参数时自动追加 busy_timeout(5000)（默认 one-api.db）
SQLITE_PATH=one-api.db
# 日志单独存库（规则同 SQL_DSN），为空时与业务库共用
LOG_SQL_DSN=
# 连接池：最大空闲连接（默认 100）、最大连接（默认 1000）、连接最长存活秒数（默认 60）
# SQL_MAX_IDLE_CONNS=100
# SQL_MAX_OPEN_CONNS=1000
# SQL_MAX_LIFETIME=60
# 慢查询日志阈值，毫秒（默认 500）
# SQL_SLOW_THRESHOLD_MS=500

# ==================== 缓存 ====================
# Redis：配置后限流走 Redis（多实例共享），否则走内存
# 方式一：连接串，如 redis://:password@localhost:6379/0
REDIS_CONN_STRING=
# 方式二：地址 + 密码 + 库号（REDIS_CONN_STRING 为空时生效）
# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0
# 连接池大小（默认 10）
# REDIS_POOL_SIZE=10
# 渠道缓存从数据库重建的间隔，秒（默认 60）
SYNC_FREQUENCY=60
# 大请求体落盘缓存（默认关闭）：超过阈值的请求体写入磁盘，减少内存占用
DISK_CACHE_ENABLED=false
# DISK_CACHE_THRESHOLD_MB=10
# DISK_CACHE_MAX_SIZE_MB=1024
# 缓存目录（默认系统临时目录）
# DISK_CACHE_PATH=

# ==================== 节点类型 ====================
# master：执行数据库迁移、异步任务轮询、定时任务；slave：只处理请求（默认 master）
# 多实例部署时只保留一个 master，其余设为 slave
NODE_TYPE=master

# ==================== 任务和功能 ====================
# 异步任务（视频等）后台轮询，默认 master 开启、slave 关闭
# UPDATE_TASK=true
# 每次轮询最多查询的任务数（默认 1000）
# TASK_QUERY_LIMIT=1000
# 任务超时分钟数，超时未完成的任务标记为失败（默认 1440）
# TASK_TIMEOUT_MINUTES=1440
# 通用定时任务调度（如定时测试渠道），默认 master 开启、slave 关闭
# CRON_ENABLED=true
# 失败重试次数（默认 0，不重试）
RETRY_TIMES=0
# 渠道连续失败自动禁用（默认 true）及连续失败阈值（默认 5）
CHANNEL_AUTO_DISABLE_ENABLED=true
CHANNEL_AUTO_DISABLE_THRESHOLD=5
# 记录错误日志（默认 true）
ERROR_LOG_ENABLED=true

# ==================== 转发 ====================
# 上游请求超时，秒（默认 0，不限制）
RELAY_TIMEOUT=0
# 流式响应无数据超时，秒（默认 300）
STREAMING_TIMEOUT=300
# 流式请求强制附带 stream_options 以获取用量（默认 true）
# FORCE_STREAM_OPTION=true
# 上游 HTTP 连接池（默认 500 / 每主机 100）
# RELAY_MAX_IDLE_CONNS=500
# RELAY_MAX_IDLE_CONNS_PER_HOST=100
# 请求体大小上限 MB（默认 128）
# MAX_REQUEST_BODY_MB=128
# 下载文件（图片等）大小上限 MB（默认 64）
# MAX_FILE_DOWNLOAD_MB=64
# 流式扫描单行缓冲上限 MB（默认 64）
# STREAM_SCANNER_MAX_BUFFER_MB=64

# ==================== 系统负载保护 ====================
# 开启后 CPU / 内存 / 磁盘使用率超过阈值（百分比）时拒绝转发请求（默认关闭）
PERFORMANCE_MONITOR_ENABLED=false
# PERFORMANCE_CPU_THRESHOLD=90
# PERFORMANCE_MEMORY_THRESHOLD=90
# PERFORMANCE_DISK_THRESHOLD=90
